# Deployment configuration. Copy these values into the office-owned Vercel project.
# Set the final production domain after DNS is connected, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# CMS / consultation backend
LAWFIRM_CMS_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of trusted admin origins. Include the final production domain.
ADMIN_ALLOWED_ORIGINS=

# Optional: random string (32+ chars) used to salt booking rate-limit fingerprints.
CONSULTATION_HASH_SALT=

# Optional SEO ownership verification
GOOGLE_SITE_VERIFICATION=

# Never commit or expose the Supabase service-role key to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
